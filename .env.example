# Server Port (Render, Railway, Fly.io provide this automatically)
PORT=3000

# Base Public URL (Used for generating absolute QR codes on phones)
# If left blank, the server will auto-detect from incoming request headers
BASE_URL=

# Environment ('development' or 'production')
NODE_ENV=production

# Database & Storage
DATA_DIR=./data
DB_PATH=./data/trip_game.db

# CORS Allowed Origins (Comma-separated or * for wildcard)
ALLOWED_ORIGINS=*

# Session Inactivity TTL (in hours) before abandoned sessions are cleaned up
SESSION_TTL_HOURS=6

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
